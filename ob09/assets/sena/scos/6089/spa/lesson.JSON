: "", "type": "text"}], "id": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0}], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Quiz", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "stimuli_ids": [], "template_override": 1, "id": 11, "type": "RSLT"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "_data": [], "title": "", "template_override": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "engenn7le13ob09re2img05.jpg", "audiosrc": "engenn7le13ob09re2aud01", "images": [{"time": "0", "image": "engenn7le13ob09re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn7le13ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Great movie choice Sally! The consummate college rom-com that takes you back.<br/>\n<span class=\"strong\">Sally</span>: Yeah! She runs into him at the coffee shop that he goes to all the time. They team up to study. He finds out about the guy that she used to be with ...<br/>\n<span class=\"strong\">Vanessa</span>: The one who walked out on her! How she felt discouraged because she could never live up to his expectations, which were totally unreal."}, {"time": "22700", "image": "engenn7le13ob09re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: I wish it were all that easy!<br/>\n<span class=\"strong\">Vanessa</span>: I do too. If having it all were so easy, everyone would be happy.<br/>\n<span class=\"strong\">Sally</span>: If college was actually like they showed it in the movies, it would be a snap!<br/>\n<span class=\"strong\">Vanessa</span>: I wish I could just go back for a few days and enjoy it all again.<br/>\n<span class=\"strong\">Sally</span>: If I'm not mistaken, Peter had a crush on you early on."}, {"time": "43500", "image": "engenn7le13ob09re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Let's not go there. Please. I have to say, he was the one who made me feel comfortable here in Cambridge. He took me out to eat, to concerts and to the comic book store!<br/>\n<span class=\"strong\">Sally</span>: He's just one of those guys who make great friends!<br/>\n<span class=\"strong\">Vanessa</span>: Hey, it's still early. We could give him a call and see what he's up to! <br/>\n<span class=\"strong\">Sally</span>: Great idea!"}]}}], "type": "audio"}]}], "type": "sena"}