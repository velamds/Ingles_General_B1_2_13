ack"}, {"contents": [{"content": "Instructions: Listen to the audio. Select the correct answer to complete the sentence.", "type": "text"}], "type": "post_instructions"}], "id": 10, "type": "DMC"}, {"questions": [{"_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Quiz", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "id": 11, "type": "RSLT"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "contents": [{}], "id": 0}, {"_data": [], "title": "", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn7le13ob11re2img05.jpg", "audiosrc": "engenn7le13ob11re2aud01", "images": [{"time": "0", "image": "engenn7le13ob11re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn7le13ob11re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Peter</span>: Vanessa, I have to say that was an amazing meal! The other cooks that you work with must be worried they can't keep up with you.<br/>\n<span class=\"strong\">Vanessa</span>: I don't think so, but thanks for the compliment!<br/>\n<span class=\"strong\">Sally</span>: I was saying earlier that I wish I could cook like Vanessa!<br/>\n<span class=\"strong\">Peter</span>: I wish you could too. I'd stop by your place for dinner, too, if you could."}, {"time": "19500", "image": "engenn7le13ob11re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Sally wouldn't have to eat out so much if she cooked.<br/>\n<span class=\"strong\">Sally</span>: Meals that are very easy to make are first on my list. <br/>\n<span class=\"strong\">Peter</span>: You know, I wish I cooked meals that were actually edible as well.<br/>\n<span class=\"strong\">Vanessa</span>: Well let's work out when to meet and practice cooking dishes which are simple.<br/>\n<span class=\"strong\">Peter</span>: We could stop by here.<br/>\n<span class=\"strong\">Vanessa</span>: You can each bring along some of the ingredients."}, {"time": "40500", "image": "engenn7le13ob11re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: It dawns on me we need pans that we can cook food in, too!<br/>\n<span class=\"strong\">Peter</span>: After we can go out to a movie. <br/>\n<span class=\"strong\">Vanessa</span>: I'd be into some coffee at our favorite old haunt as well.<br/>\n<span class=\"strong\">Sally</span>: That way we can always catch up on the latest news!<br/>\n<span class=\"strong\">Peter</span>: If I learn to cook, do you think the ladies that I take out will like it?<br/>\n<span class=\"strong\">Vanessa</span>: Oh Peter!"}]}}], "template_override": 1, "type": "audio", "id": 1}], "id": 0}], "_data": [{"contents": [{"content": "A Quiet Night at Home", "type": "lesson_name"}, {"content": "I Wish I Could", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B1.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Use expressions about relationships and feelings in a range of social and work contexts.", "type": "primary"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_1"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_2"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_3"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_4"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_5"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_6"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_7"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Talking about Wishes and Imaginary Situations", "type": "heading"}, {"content": "You use <span class=\"strong\">wish</span> and the second conditional to talk about imaginary situations in the present or future.", "type": "describer"}, {"content": "Wishes and sentences in the second conditional infer that what you want is probably not possible, or for some reason impossible.", "type": "text"}, {"content": "You can make negative conditionals by adding a negative work or negative auxiliary verb.", "type": "text"}, {"content": "For example:<br/><span class=\"italic\">I wouldn't ask you over if I <span class=\"strong\">had nothing</span> to offer you.</span> <br/>or <br/><span class=\"italic\">I wouldn't ask you over if I <span class=\"strong\">didn't have anything</span> to offer you.</span>", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Statement</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Meaning</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish I had known earlier!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I didn't know earlier.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wouldn't ask you over if I had nothing to offer you.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I do have something to offer you.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If I could, I would eat wherever you cooked every night of the week!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I can't eat where you cook every night.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish I could tell you something good.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I can't tell you anything good.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Subject and Object Relative Clauses", "type": "heading"}, {"content": "<p>When you want to clarify which person or thing you are talking about, you use a relative clause.</p><p>You can begin a relative clause with <span class=\"italic\">who</span> for people, <span class=\"italic\">which</span> for things or <span class=\"italic\">that</span> for either people or things.</p>You put the relative clause immediately after the noun it talks about.", "type": "describer"}, {"content": "A subject relative clause describes the subject of the clause.", "type": "text"}, {"content": "An object relative clause describes the object of the clause.", "type": "text"}, {"content": "The other cooks that you work with must be worried they can't keep up with you.", "type": "example"}, {"content": "Meals that are very easy to make are first on my list.", "type": "example"}, {"content": "I wish I cooked meals that were actually edible!", "type": "example"}, {"content": "I'm cooking two pasta dishes which are simple.", "type": "example"}, {"content": "Will the ladies that I take out like it?", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "to work out", "type": "name"}, {"content": "to solve", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You always help me work out my problems.", "type": "example"}, {"content": "engenn7le13ob11aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you need to review.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to stop by", "type": "name"}, {"content": "to visit", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'm glad that you stopped by today.", "type": "example"}, {"content": "engenn7le13ob11aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to bring along", "type": "name"}, {"content": "to carry with", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I brought a couple of movies along in case you wanted to watch something.", "type": "example"}, {"content": "engenn7le13ob11aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to dawn on", "type": "name"}, {"content": "to realize", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  It would never have dawned on me to go to Japantown at 5 a.m.!", "type": "example"}, {"content": "engenn7le13ob11aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to go out", "type": "name"}, {"content": "to participate in social activities", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I never go out anymore!", "type": "example"}, {"content": "engenn7le13ob11aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to be into", "type": "name"}, {"content": "to be interested in", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Are you into comic books?", "type": "example"}, {"content": "engenn7le13ob11aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to catch up with", "type": "name"}, {"content": "to exchange information about your personal lives", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I haven't caught up with Peter in weeks!", "type": "example"}, {"content": "engenn7le13ob11aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "amazing", "type": "name"}, {"content": "astonishing", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It's an amazing opportunity!", "type": "example"}, {"content": "engenn7le13ob11aud08", "type": "audio"}], "type": "target_word"}, {"content": "engenn7le13ob11re1img01.jpg", "type": "background_image"}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about friends and a social activity.", "type": "text"}, {"content": "I use phrasal verbs in an informal conversation.", "type": "text"}, {"content": "I clarify which things and people I am talking about.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Identify some phrasal verbs you can use in your conversation.", "type": "text"}, {"content": "Have your friend talk about what they wish they could do.", "type": "text"}, {"content": "Invite them over and say how you can help them.", "type": "text"}, {"content": "Use complex sentences to make the dialogue more interesting.", "type": "text"}, {"content": "Read the dialogue with a partner.", "type": "text"}]}], "type": "sena"}