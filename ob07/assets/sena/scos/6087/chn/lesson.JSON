content": "", "type": "text"}], "id": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0}], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Quiz", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "stimuli_ids": [], "template_override": 1, "id": 11, "type": "RSLT"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "_data": [], "title": "", "template_override": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "engenn7le13ob07re2img05.jpg", "audiosrc": "engenn7le13ob07re2aud01", "images": [{"time": "0", "image": "engenn7le13ob07re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn7le13ob07re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Here you are. Teacakes!<br/>\n<span class=\"strong\">Sally</span>: Hmm. Comfort food! What would I do if I didn't know you?<br/>\n<span class=\"strong\">Vanessa</span>: If we didn't know each other, we wouldn't have anyone to work out our problems with. I was relieved when we got on with each other. <br/>\n<span class=\"strong\">Sally</span>: Me too. Not having friends in a new place must be distressing!"}, {"time": "19000", "image": "engenn7le13ob07re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Hmmm. I wish I could look into the future! I'd like to see where I might be in a few years!<br/>\n<span class=\"strong\">Sally</span>: Would you want to get married if you met Mr. Right?<br/>\n<span class=\"strong\">Vanessa</span>: You mean if I fell for someone who I could actually tolerate? <br/>\n<span class=\"strong\">Sally</span>: When I think about moving in with someone I get nervous. I must be scared deep down!<br/>\n<span class=\"strong\">Vanessa</span>: I wish I knew that the next relationship wouldn't be as disappointing as the last one."}, {"time": "44000", "image": "engenn7le13ob07re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: Marco. He could be challenging to say the least. It must be frustrating to be in a relationship like that. <br/>\n<span class=\"strong\">Vanessa</span>: I was often astounded by his behavior.<br/>\n<span class=\"strong\">Sally</span>: If I found someone I got along well with in the future, I might consider marriage.\nLike you, I wish I knew where I would be and what I'd be doing. I could be anywhere!<br/>\n<span class=\"strong\">Vanessa</span>: Me too. <br/>\n<span class=\"strong\">Sally</span>: OK. Another movie?<br/>\n<span class=\"strong\">Vanessa</span>: Yesssss."}]}}], "type": "audio"}]}], "type": "sena"}