esponses": [{"id": 0, "correct": 0, "_data": [{"content": "example", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "episode", "type": "text"}], "selected": 0}], "id": 1, "_data": [{"type": "question", "contents": [{"content": "Did you see the final", "type": "text"}]}, {"type": "post_question", "contents": {"content": "of <span class=\"italic\">The Last Survivor</span>?", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 1, "_data": [{"content": "lost", "type": "text"}], "selected": 0}, {"id": 1, "correct": 0, "_data": [{"content": "losing", "type": "text"}], "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "I was", "type": "text"}]}, {"type": "post_question", "contents": {"content": "for words when she told me about the tragedy.", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"type": "audio", "_data": [], "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn7le13ob08re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Sally</span>: Hey Peter, come in. Oh, you brought some nibbles. Thanks!<br/>\n<span class=\"strong\">Peter</span>: No problem.  You know I like spending time with you guys. I also downloaded some new music to my phone we can listen to later.<br/>\n<span class=\"strong\">Vanessa</span>: Hey there stranger! Ready for a <span class=\"italic\">Quest For Empires</span> marathon? We're starting at episode two.<br/>\n<span class=\"strong\">Peter</span>: Hi Vanessa. Sounds good. We still on for a gym session tomorrow morning?<br/>\n<span class=\"strong\">Vanessa</span>: Absolutely. Hey ... are you ok? Is something wrong?", "image": "engenn7le13ob08re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Peter</span>: I just got a call from a co-worker on my way over. James' father died last night in his sleep.<br/>\n<span class=\"strong\">Sally</span>: James from work? Was his dad ill?<br/>\n<span class=\"strong\">Peter</span>: It was a massive heart attack. He was only 58.<br/>\n<span class=\"strong\">Vanessa</span>: The poor guy. It must be such a distressing time for his family.<br/>\n<span class=\"strong\">Sally</span>: How is he handling it? It must be so upsetting to receive that kind of news.<br/>\n<span class=\"strong\">Peter</span>: He was trying to be strong but I could tell he was on the verge of crying.", "image": "engenn7le13ob08re2img01.jpg", "time": "38000", "id": 2}, {"text": "<span class=\"strong\">Vanessa</span>: I would be so shocked if I someone close to me suddenly passed away. <br/>\n<span class=\"strong\">Peter</span>: I'm not sure what I should do next. I was lost for words on the phone. <br/>\n<span class=\"strong\">Vanessa</span>: He needs a shoulder to lean on.<br/>\n<span class=\"strong\">Sally</span>: A letter of sympathy would also show that you are thinking about him during this difficult time. I would be so confused and angry.<br/>\n<span class=\"strong\">Peter</span>: Yeah ... a letter might be a good idea.  I seem to be a little tongue tied at the moment.", "image": "engenn7le13ob08re2img05.jpg", "time": "69000", "id": 3}], "coverimg": "engenn7le13ob08re2img05.jpg", "audiosrc": "engenn7le13ob08re2aud01"}, "type": "slideshow"}]}, {"type": "video", "_data": [], "title": "", "template_override": 1, "id": 2, "contents": [{"value": {"video_src": "engenn7le13ob08re3vid01", "images": [{"text": "", "image": "", "time": "0", "id": 0}, {"text": "A Letter of Sympathy", "image": "", "time": "1", "id": 1}, {"text": "<li>What is a letter of sympathy?</li>", "image": "", "time": "14000", "id": 2}, {"text": "<li>What do they include?</li>", "image": "", "time": "40000", "id": 3}, {"text": "<li>Example</li>", "image": "", "time": "63000", "id": 4}]}, "type": "video"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "A Quiet Night at Home", "type": "lesson_name"}, {"content": "A Sympathy Letter", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Use expressions about relationships and feelings in a range of social and work contexts.", "type": "primary"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_1"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_2"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_3"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_4"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_5"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_6"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_7"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Writing a personal letter/e-mail to express sympathy", "type": "heading"}, {"content": "You write a sympathy letter to honour the life of the deceased and to support their family and friends.  It is important the information contained in the letter expresses sympathy, kindness and support.", "type": "describer"}, {"content": "Letters of sympathy are written, not typed, and are kept fairly short. Think about what you would want someone to say to you if you were in this difficult situation.", "type": "text"}, {"content": "Letters of sympathy include:<ul><li>How you heard about the news and your reaction</li><li>Your sincere condolences to the person and the rest of their family</li><li>Your feelings about the deceased</li><li>Any memories or personal stories</li><li>An offering of support and assistance</li><li>A closing that expresses affection and support</li></ul>", "type": "text"}, {"content": "Make sure your handwriting is clear and neat. Ensure that your spelling is correct and there are no grammatical errors. Proofread your letter before you send it.", "type": "text"}, {"content": "I am so sorry to hear about the tragic death of your father.", "type": "example"}, {"content": "He was one of the kindest, most generous people we knew.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Show you understand someone's feelings or situation", "type": "heading"}, {"content": "<p>You use a <span class=\"strong\">modal</span> like <span class=\"italic\">must</span>, <span class=\"italic\">would</span> or <span class=\"italic\">could</span> followed by an adjective when you want to empathize with someone. When you empathize with someone, you show them that you understand their situation or feelings.</p>To talk about situations, use the <span class=\"italic\">-ing</span> form of the adjective.<br/>To talk about feelings use the <span class=\"italic\">-ed</span> form of the adjective.", "type": "describer"}, {"content": "Here is the structure to follow:", "type": "text"}, {"content": "subject + modal + verb + adjective", "type": "text"}, {"content": "Don't forget to include the verb before the adjective.", "type": "text"}, {"content": "It must be so upsetting to receive that kind of news.", "type": "example"}, {"content": "I would be so shocked if I someone close to me suddenly passed away.", "type": "example"}, {"content": "It must be such a distressing time for his family.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "nibbles", "type": "name"}, {"content": "small things to eat before a meal or at a party; snacks or appetizers", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Oh, you brought some nibbles.", "type": "example"}, {"content": "engenn7le13ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you hear in a conversation between friends.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "quest", "type": "name"}, {"content": "a long and difficult effort to find or do something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Ready for a Quest For Empires marathon?", "type": "example"}, {"content": "engenn7le13ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "session", "type": "name"}, {"content": "a period of time that is used to do a particular activity", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We still on for a gym session tomorrow morning?", "type": "example"}, {"content": "engenn7le13ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "heart attack", "type": "name"}, {"content": "a sudden painful and dangerous condition in which your heart stops beating properly", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: It was a massive heart attack.", "type": "example"}, {"content": "engenn7le13ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "verge", "type": "name"}, {"content": "at the point when something is about to happen or is very likely to happen", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He was on the verge of crying.", "type": "example"}, {"content": "engenn7le13ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to pass away", "type": "name"}, {"content": "to die - used as a polite way to avoid saying the word \u201cdie\u201d", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I would be so shocked if someone close to me suddenly passed away.", "type": "example"}, {"content": "engenn7le13ob08aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tongue tied", "type": "name"}, {"content": "to find it difficult to respond to information", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I seem to be a little tongue tied at the moment.", "type": "example"}, {"content": "engenn7le13ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "condolences", "type": "name"}, {"content": "feelings or expressions of sympathy and sadness, especially when someone is suffering because of the death of a family member or friend", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to express my condolences to you and your family.", "type": "example"}, {"content": "engenn7le13ob08aud08", "type": "audio"}]}, {"content": "engenn7le13ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_assessment", "contents": [{"content": "I write a dialogue giving advice on how to write a letter of sympathy.", "type": "text"}, {"content": "I include adjectives with -ed and -ing endings.", "type": "text"}, {"content": "I read the dialogue about expressing sympathy to a partner.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a 12 line dialogue between you and a friend.", "type": "text"}, {"content": "Your friend's co-worker has recently lost a family member.", "type": "text"}, {"content": "Your friend wants to write a letter of sympathy. What should they include?", "type": "text"}, {"content": "Include sentences using adjectives with -ed and -ing endings.", "type": "text"}, {"content": "Read the dialogue aloud to a partner.", "type": "text"}]}]}